  "query": "\n            SELECT id, chat_id, sender_id, content, created_at, updated_at, deleted_at\n            FROM messages\n            WHERE chat_id = $1\n            AND (deleted_at IS NULL OR $2 = true)\n            ORDER BY created_at DESC\n            LIMIT $3 OFFSET $4\n            ",
